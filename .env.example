# Copy to .env for local use, or set these in the hosting panel (Coolify).
# Never put a plain password here: run `npm run set-password` and it writes only a hash.

# Where the site lives; used in confirmation and unsubscribe links
SITE_URL=https://slocabaia.com
PORT=3000

# Dashboard login
ADMIN_EMAIL=slocabaia@gmail.com
ADMIN_PASSWORD_HASH=

# Sending. Without RESEND_API_KEY the server runs in test mode and writes every email
# to data/outbox instead of sending it. MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=Slocabaia <news@slocabaia.com>
MAIL_REPLY_TO=slocabaia@gmail.com

# Storage for the member list and statistics (mount a persistent volume here in production)
DATA_DIR=data

# Behind Coolify/Traefik: trust X-Forwarded-For / X-Forwarded-Proto
TRUST_PROXY=0
NODE_ENV=development

# One real address. Every host in ALIAS_HOSTS (and www.<canonical>) gets a permanent
# redirect to https://CANONICAL_HOST with the same path. Leave empty locally.
CANONICAL_HOST=
ALIAS_HOSTS=slocabaia.nl,www.slocabaia.nl,slocabaia.store,www.slocabaia.store,slocabaia.online,www.slocabaia.online

# Notifications in the dashboard app (web push). Optional: without these the server makes a
# key pair once and keeps it in the database on the data volume.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Hero video processing needs ffmpeg and ffprobe (the Docker image installs them)
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
